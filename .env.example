# =============================================================================
# Variáveis de ambiente do SIG – Validação de Disciplinas
# Copie este arquivo para `.env` (na mesma pasta) e preencha os valores.
# Após editar o `.env`, reinicie o `npm run dev`.
# =============================================================================

# ────────────── Supabase ──────────────
# URL e chave pública do projeto Supabase (Authentication + Database + Storage)
# Encontre em: Supabase → Project Settings → API
VITE_SUPABASE_URLhttps://sygcnmuyhfacujmsaeus.supabase.co/rest/v1/
VITE_SUPABASE_ANON_KEY=sb_publishable_-enE54JTOCA0LsAg4E6dHw_Nzt09AWC

# ────────────── n8n (webhook local em Docker) ──────────────
# Base URL do n8n — todos os webhooks derivam daqui.
# Em produção, troque pelo domínio real (ex: https://n8n.ufsc.br).
VITE_N8N_BASE_URL=http://localhost:5678

# Webhook de submissão do requerimento
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/sig-requerimento

# Webhooks de autenticação (magic link)
# Criados no n8n como workflows separados:
#   sig-auth-request → recebe { email }, valida @ufsc.br, envia link por e-mail
#   sig-auth-verify  → recebe { token }, valida no banco, devolve JWT
# (derivados automaticamente de VITE_N8N_BASE_URL — não precisam ser definidos
#  aqui a não ser que o path mude)
# VITE_N8N_AUTH_REQUEST_URL=http://localhost:5678/webhook/sig-auth-request
# VITE_N8N_AUTH_VERIFY_URL=http://localhost:5678/webhook/sig-auth-verify

# ATENÇÃO ao testar pelo n8n:
# - O path /webhook/...      é usado pela versão "Production" (workflow ATIVO).
# - O path /webhook-test/... é usado pela versão "Test" (precisa abrir o
#   workflow e clicar em "Execute workflow" antes de cada teste).

# ────────────── EmailJS (envio de e-mail no navegador) ──────────────
# Credenciais do EmailJS. Os 3 campos abaixo são necessários para o envio
# por e-mail funcionar. Se deixar em branco, o sistema usa só o n8n.
# Cadastro gratuito: https://www.emailjs.com/
VITE_EMAILJS_SERVICE_ID=service_77oafd6
VITE_EMAILJS_TEMPLATE_ID=template_rozlth7
VITE_EMAILJS_PUBLIC_KEY=4xiEhWmIDjQvDdLLj

# E-mail de destino (configurado no template do EmailJS)
VITE_EMAILJS_TO_EMAIL=central.autosig@gmail.com
